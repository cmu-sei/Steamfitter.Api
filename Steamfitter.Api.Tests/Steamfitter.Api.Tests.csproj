<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Off, as in the Steamfitter projects: every file names its own usings (the shared files carry theirs). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Steamfitter.Api.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!--
      Microsoft.Testing.Platform (global.json test.runner): the test project runs as its own test app, under
      `dotnet test` and `dotnet run` alike. xunit.v3 4 and later only run this way on the .NET 10 SDK.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- No central package management in this repository, so the versions are the standard's test-packages.props. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <!-- Hosts the API in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- The SignalR client for EngineHub's real-connection tests (Hubs/EngineHubConnectionTests); optional in the standard. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not a test package. Steamfitter.Api compiles against Newtonsoft.Json 13.0.3, which reaches it only
      through Microsoft.EntityFrameworkCore.Design (PrivateAssets=all), so a project referencing the API
      gets IdentityModel's 11.0.2 instead and MSBuild reports the conflict (MSB3277). This pins the
      version the API was built against.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Steamfitter.Api\Steamfitter.Api.csproj" />
  </ItemGroup>

</Project>
